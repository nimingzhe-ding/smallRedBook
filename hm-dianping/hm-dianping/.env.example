XHS_DATASOURCE_PASSWORD=change-me

XHS_REDIS_HOST=127.0.0.1
XHS_REDIS_PORT=6379
XHS_REDIS_PASSWORD=

XHS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
XHS_ELASTICSEARCH_URIS=http://localhost:9200

XHS_CANAL_ENABLED=false

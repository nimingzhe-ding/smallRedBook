COMPOSE_PROJECT_NAME=xiaohongshu

XHS_STORAGE_TYPE=local
XHS_OSS_ENDPOINT=
XHS_OSS_BUCKET=
XHS_OSS_ACCESS_KEY=
XHS_OSS_SECRET_KEY=
XHS_OSS_DOMAIN=

XHS_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/xiaohongshu?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

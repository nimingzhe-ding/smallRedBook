XHS_CANAL_MYSQL_USERNAME=canal
XHS_CANAL_MYSQL_PASSWORD=change-me

XHS_DANMAKU_WS_PORT=8090
XHS_PRIVATE_MESSAGE_WS_PORT=8091

XHS_AI_ENABLED=false
